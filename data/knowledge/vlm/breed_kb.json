          "welsh springer"
        ]
      },
      "attributes": [
        {
          "attribute_id": "coat_color",
          "value": "Màu đỏ đậm và trắng theo hai tiêu chuẩn được đối chiếu. Thấy thân, kiểm ánh sáng đỏ/cam.",
          "source_ids": [
            "fci-126",
            "rkc-welsh-springer"
          ]
        },
        {
          "attribute_id": "ear_shape",
          "value": "Vành tai tương đối nhỏ và thuôn dần về chóp. Cần thấy vành tai, góc ngang hoặc ba phần tư, tránh lông che.",
          "source_ids": [
            "fci-126",
            "rkc-welsh-springer"
          ]
        },
        {
          "attribute_id": "coat_texture",
          "value": "Lông thẳng hoặc phẳng, mượt và dày. Quan sát lông khô rõ nét. Không suy cảm giác khi chạm từ ảnh.",
          "source_ids": [
            "fci-126",
            "rkc-welsh-springer"
          ]
        }
      ]
    },
    {
      "class_id": 17,
      "canonical_name": "Cocker Spaniel",
      "aliases": {
        "vi": [
          "chó cocker anh"
        ],
        "en": [
          "english cocker spaniel",
          "english cocker"
        ]
      },
      "attributes": [
        {
          "attribute_id": "ear_shape",
          "value": "Tai dạng thùy, vành mảnh dài tới chóp mũi theo mô tả của tiêu chuẩn English Cocker Spaniel. Ảnh đơn lẻ thường chỉ hỗ trợ đánh giá độ dài tương đối của tai.",
          "source_ids": [
            "fci-005"
          ]
        },
        {
          "attribute_id": "body_build",
          "value": "Dáng gọn, chắc và cân đối, hai kích thước vai–đất và vai–gốc đuôi gần nhau theo tiêu chuẩn. Ảnh bên đủ toàn thân, chân đứng tự nhiên. Không ước tính số đo từ crop. Phạm vi mô tả là English Cocker Spaniel.",
          "source_ids": [
            "fci-005"
          ]
        },
        {
          "attribute_id": "coat_texture",
          "value": "Lông phẳng, mượt theo chuẩn English Cocker. Thấy lông tự nhiên, không suy từ bóng phản chiếu. WordNet dùng để chọn tên tương đương. Phạm vi mô tả là English Cocker Spaniel.",
          "source_ids": [
            "fci-005"
          ]
        }
      ]
    },
    {
      "class_id": 18,
      "canonical_name": "Norfolk Terrier",
      "aliases": {
        "vi": [
          "chó sục norfolk"
        ],
        "en": [
          "norfolk terrier dog"
        ]
      },
      "attributes": [
        {
          "attribute_id": "ear_position",
          "value": "Tai rủ ra trước và áp gần má. Thấy hướng mang tai từ chính diện hoặc ba phần tư. Dáng tai chữ V là dấu hiệu hình tai riêng.",
          "source_ids": [
            "fci-272"
          ]
        },
        {
          "attribute_id": "head_shape",
          "value": "Đầu rộng hơi vồng, mõm nêm khỏe. Thấy mặt trước và profile, không dùng đầu để tách riêng Norfolk với Norwich.",
          "source_ids": [
            "fci-272"
          ]
        },
        {
          "attribute_id": "coat_texture",
          "value": "Lông cứng, thẳng và thô, nằm sát thân. Vùng thân rõ và không vừa tỉa sát.",
          "source_ids": [
            "fci-272"
          ]
        }
      ]
    },
    {
      "class_id": 19,
      "canonical_name": "Norwich Terrier",
      "aliases": {
        "vi": [
          "chó sục norwich"
        ],
        "en": [
          "norwich terrier dog"
        ]
      },
      "attributes": [
        {
          "attribute_id": "ear_position",
          "value": "Tai dựng lúc chú ý, có thể ngả ra sau lúc nghỉ. Hai tai rõ, chó đang chú ý. Tai nhọn thuộc hình tai, chưa cần xuất ID riêng ở lớp này.",
          "source_ids": [
            "fci-072"
          ]
        },
        {
          "attribute_id": "coat_texture",
          "value": "Lông cứng, thẳng và thô, áp sát thân. Grooming và độ phân giải có thể che kết cấu lông.",
          "source_ids": [
            "fci-072"
          ]
        }
      ]
    },
    {
      "class_id": 20,
      "canonical_name": "Border Terrier",
      "aliases": {
        "vi": [
          "chó sục border"
        ],
        "en": [
          "border terrier dog"
        ]
      },
      "attributes": [
        {
          "attribute_id": "head_shape",
          "value": "Đầu kiểu rái cá, với sọ rộng vừa và mõm ngắn khỏe. Chính diện và góc ngang rõ mõm, chỉ gợi ý khi thấy hình học đầu.",
          "source_ids": [
            "fci-010"
          ]
        },
        {
          "attribute_id": "coat_texture",
          "value": "Lông ngoài thô trên lớp lót sát thân. Lông khô đủ chi tiết. Mật độ lớp lót không suy chắc từ ảnh.",
          "source_ids": [
            "fci-010"
          ]
        },
        {
          "attribute_id": "ear_position",
          "value": "Tai rủ về trước gần má. Tai hai bên rõ.",
          "source_ids": [
            "fci-010"
          ]
        }
      ]
    },
    {
      "class_id": 21,
      "canonical_name": "Collie",
      "aliases": {
        "vi": [
          "chó collie"
        ],
        "en": [
          "scottish collie"
        ]
      },
      "attributes": [
        {
          "attribute_id": "head_shape",
          "value": "Đầu dạng nêm tù, thon dần, với đoạn chuyển trán–mõm nhẹ nhưng thấy được. Ưu tiên góc nghiêng đủ trán và mõm. Đặc điểm tương ứng trong cả hai chuẩn Rough và Smooth; phân bố biến thể trong lớp dữ liệu chưa xác minh.",
          "source_ids": [
            "fci-156",
            "fci-296"
          ]
        },
        {
          "attribute_id": "ear_position",
          "value": "Tai bán dựng khi chú ý, chóp gập ra trước. Cả chuẩn Rough và Smooth mô tả cách mang này. Thấy hai tai, chó chú ý.",
          "source_ids": [
            "fci-156",
            "fci-296"
          ]
        },
        {
          "attribute_id": "coat_length",
          "value": "Hai chuẩn tham chiếu mô tả Rough có bờm rõ và Smooth có lông ngoài ngắn; phân bố biến thể của lớp dữ liệu chưa xác minh. Chỉ dùng với bộ lông đủ rõ. Giữ biến thiên ở KB, không chèn vào prompt.",
          "source_ids": [
            "fci-156",
            "fci-296"
          ]
        }
      ]
    },
    {
      "class_id": 22,
      "canonical_name": "Shetland Sheepdog",
      "aliases": {
