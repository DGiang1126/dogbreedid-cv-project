        ]
      },
      "attributes": [
        {
          "attribute_id": "coat_fullness",
          "value": "Bộ lông trông dày, theo gloss của synset chó kéo xe Bắc Cực. Thân và phần lông ngoài thấy rõ, phụ thuộc mùa và hình chiếu. Nhãn WordNet n02109961 có phạm vi từ vựng; chưa xác lập đồng nhất với Canadian Eskimo Dog.",
          "source_ids": [
            "princeton-wordnet"
          ],
          "uncertainty_note": "Gloss không xác định kết cấu sợi, độ dài, số lớp lông hoặc dáng đuôi."
        }
      ]
    },
    {
      "class_id": 1,
      "canonical_name": "Malamute",
      "aliases": {
        "vi": [
          "chó malamute alaska"
        ],
        "en": [
          "alaskan malamute",
          "alaska malamute"
        ]
      },
      "attributes": [
        {
          "attribute_id": "body_build",
          "value": "Thân lực lưỡng, xương nặng và ngực sâu. Thấy ngang thân và chân. Lông dày, mỡ và góc máy có thể làm thân trông rộng.",
          "source_ids": [
            "fci-243"
          ]
        },
        {
          "attribute_id": "tail_shape",
          "value": "Đuôi xù dạng chùm lông, thường đưa qua lưng khi không làm việc, không cuộn sát. Đuôi hiện đầy đủ và thấy đường viền lưng. Tư thế thay đổi cách mang.",
          "source_ids": [
            "fci-243"
          ]
        },
        {
          "attribute_id": "coat_texture",
          "value": "Lông bảo vệ thô trên lớp lót dày. Vùng thân rõ, mức dày lớp lót phụ thuộc mùa, kết cấu sợi cần cận cảnh.",
          "source_ids": [
            "fci-243"
          ]
        }
      ]
    },
    {
      "class_id": 2,
      "canonical_name": "Siberian Husky",
      "aliases": {
        "vi": [
          "chó husky siberia"
        ],
        "en": [
          "husky siberian",
          "husky"
        ]
      },
      "attributes": [
        {
          "attribute_id": "body_build",
          "value": "Dáng gọn vừa phải, ngực sâu nhưng không quá rộng. Ảnh ngang đủ thân, tránh góc rộng gần đầu. So với chuẩn của ID 1 chỉ là nhận định tương đối.",
          "source_ids": [
            "fci-270"
          ]
        },
        {
          "attribute_id": "tail_shape",
          "value": "Đuôi dạng chổi cong lưỡi liềm khi chú ý, có thể rủ lúc nghỉ. Thấy cả đuôi khi chú ý. Không dựa vào chỉ riêng việc mang cao.",
          "source_ids": [
            "fci-270"
          ]
        },
        {
          "attribute_id": "coat_texture",
          "value": "Lông ngoài thẳng, khá áp thân, trên lớp lót mềm dày có thể thay theo mùa. Lông khô, rõ vùng thân. Lớp lót không luôn nhìn thấy.",
          "source_ids": [
            "fci-270"
          ]
        },
        {
          "attribute_id": "ear_position",
          "value": "Tai dựng, đặt cao và tương đối gần nhau. Chính diện khi hai tai hiện rõ.",
          "source_ids": [
            "fci-270"
          ]
        }
      ]
    },
    {
