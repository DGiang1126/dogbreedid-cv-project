      "attributes": [
        {
          "attribute_id": "coat_texture",
          "value": "Lông xoăn dày hoặc bện dây. Đây là hai kiểu lông chuẩn, các cỡ dùng chung. Bộ lông đủ chi tiết ở vùng thân. Clip và grooming ảnh hưởng hình lông.",
          "source_ids": [
            "fci-172",
            "akc-poodle"
          ]
        },
        {
          "attribute_id": "ear_position",
          "value": "Tai rủ dọc má. Thấy vành và vị trí tai. Tua dài có thể che dáng.",
          "source_ids": [
            "fci-172",
            "akc-poodle"
          ]
        },
        {
          "attribute_id": "breed_size",
          "value": "Chiều cao vai theo FCI trên 24 đến 28 cm, dung sai −1 cm (lý tưởng 25 cm). AKC đo ở điểm cao nhất của vai và giới hạn đến 10 in. Chó trưởng thành đứng trên bề mặt phẳng, đo ở vai đúng hệ chuẩn. Không suy từ crop. Ngưỡng FCI và AKC là tham chiếu hình thái, không phải quy tắc gán nhãn Stanford Dogs.",
          "source_ids": [
            "fci-172",
            "akc-poodle"
          ]
        }
      ]
