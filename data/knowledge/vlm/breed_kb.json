          "chó chăn cừu shetland"
        ],
        "en": [
          "sheltie"
        ]
      },
      "attributes": [
        {
          "attribute_id": "coat_length",
          "value": "Lông ngoài dài, có bờm và diềm cổ rõ. Cổ và thân thấy rõ, lông khô.",
          "source_ids": [
            "fci-088"
          ]
        },
        {
          "attribute_id": "head_shape",
          "value": "Đầu nêm tù dài từ tai tới mũi, stop nhẹ nhưng rõ. Ảnh ngang rõ trán–mõm. Dùng để phân biệt có điều kiện với ID 23.",
          "source_ids": [
            "fci-088"
          ]
        },
        {
          "attribute_id": "ear_position",
          "value": "Tai bán dựng, chóp gập ra trước lúc chú ý. Chó đang chú ý và thấy hai tai.",
          "source_ids": [
            "fci-088"
          ]
        },
        {
          "attribute_id": "breed_size",
          "value": "FCI ghi chiều cao vai lý tưởng đực 37 cm, cái 35,5 cm, sai khác quá 2,5 cm rất không mong muốn. Đo thật ở vai chó trưởng thành. Dùng chuẩn tham chiếu, không suy từ kích thước ảnh.",
          "source_ids": [
            "fci-088",
            "fci-156",
            "fci-296"
          ]
        }
      ]
    },
    {
