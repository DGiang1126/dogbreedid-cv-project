        ],
        "en": [
          "labrador",
          "lab retriever"
        ]
      },
      "attributes": [
        {
          "attribute_id": "coat_texture",
          "value": "Lông không gợn, sợi có độ cứng khi sờ. Thân khô, có ánh sáng. Ảnh không xác nhận trực tiếp độ cứng.",
          "source_ids": [
            "fci-122"
          ]
        },
        {
          "attribute_id": "tail_shape",
          "value": "Đuôi tròn, rất dày gần gốc rồi thon dần, không tua, dạng đuôi rái cá. Đuôi nhìn rõ từ gốc đến chóp, tránh góc foreshortening.",
          "source_ids": [
            "fci-122"
          ]
        },
        {
          "attribute_id": "coat_length",
          "value": "Lông ngắn, dày, không có lông tua theo chuẩn. Thân khô, đủ độ phân giải.",
          "source_ids": [
            "fci-122"
          ]
        }
      ]
    },
    {
      "class_id": 26,
      "canonical_name": "Chesapeake Bay Retriever",
      "aliases": {
        "vi": [
          "chó chesapeake bay"
        ],
        "en": [
          "chesapeake retriever",
          "chessie"
        ]
      },
      "attributes": [
        {
          "attribute_id": "coat_texture",
          "value": "Lông có xu hướng gợn ở vai, cổ, lưng và thắt lưng. Lông mặt và chân thẳng. Lông khô, nhìn đủ vùng vai–lưng. Gợn là xu hướng, không bắt buộc thấy.",
          "source_ids": [
            "fci-263"
          ]
        },
        {
          "attribute_id": "coat_color",
          "value": "Dải tông màu nâu, sedge hoặc deadgrass theo FCI. Ánh sáng trung tính.",
          "source_ids": [
            "fci-263"
          ]
        },
        {
          "attribute_id": "coat_length",
          "value": "Lông thân ngắn, lông mặt và chân rất ngắn. Tua vừa ở vùng sau đùi và đuôi được phép. Thấy thân. Phân biệt lông ngắn toàn thân với tua cục bộ.",
          "source_ids": [
            "fci-263"
          ]
        }
      ]
    },
    {
      "class_id": 27,
      "canonical_name": "Japanese Spaniel",
      "aliases": {
        "vi": [
          "chó nhật lùn"
        ],
        "en": [
          "japanese chin"
        ]
      },
      "attributes": [
        {
          "attribute_id": "facial_hair",
          "value": "Lông trên mặt và mõm ngắn, lông tai dài và nhiều. Mặt và mõm rõ, tai ngoài vùng claim chính. Grooming làm biến đổi dấu hiệu.",
          "source_ids": [
            "akc-japanese-chin",
            "fci-206"
          ]
        },
        {
          "attribute_id": "coat_color",
          "value": "FCI mô tả nền trắng với mảng đen hoặc đỏ. Thấy đủ nền lông và mảng. Sắc độ ở vùng crop nhỏ có thể gây nhầm.",
          "source_ids": [
            "fci-206"
          ]
        },
        {
          "attribute_id": "muzzle_length",
          "value": "Mõm ngắn theo AKC, FCI mô tả sống mũi rất ngắn. Nhìn góc nghiêng rõ mũi và đoạn chuyển. Ít phân biệt trong G10.",
          "source_ids": [
            "akc-japanese-chin",
            "fci-206"
          ]
        },
        {
          "attribute_id": "coat_texture",
          "value": "Lông thân thẳng và mượt. Lông khô, ảnh đủ nét để đánh giá bề ngoài.",
          "source_ids": [
            "fci-206",
            "akc-japanese-chin"
          ]
        }
      ]
    },
