      "class_id": 28,
      "canonical_name": "Pekinese",
      "aliases": {
        "vi": [
          "chó bắc kinh"
        ],
        "en": [
          "pekingese",
          "peke"
        ]
      },
      "attributes": [
        {
          "attribute_id": "head_shape",
          "value": "Đầu tương đối rộng, đỉnh sọ phẳng giữa hai tai theo FCI. Ảnh mặt thẳng hoặc ba phần tư, cần tách đường viền lông và sọ.",
          "source_ids": [
            "fci-207"
          ]
        },
        {
          "attribute_id": "body_build",
          "value": "Dáng nhỏ chắc vừa phải, thân cân bằng. Ảnh ngang đủ thân. Lông không được tính là khối thân.",
          "source_ids": [
            "fci-207"
          ]
        },
        {
          "attribute_id": "coat_length",
          "value": "Lông thẳng dài vừa, bờm quây quanh cổ như áo choàng và không vượt quá vai. Cổ và vai hiện rõ. Bờm thay đổi do grooming.",
          "source_ids": [
            "fci-207"
          ]
        },
        {
          "attribute_id": "muzzle_length",
          "value": "Mõm phải hiện rõ, có thể tương đối ngắn. Chiều rộng được ghi riêng ở head_shape nếu cần. Dùng góc nghiêng rõ đường viền. Không dùng độ bẹt để xếp loại.",
          "source_ids": [
            "fci-207"
          ]
        }
      ]
    },
    {
      "class_id": 29,
      "canonical_name": "Shih-Tzu",
      "aliases": {
        "vi": [
          "chó sư tử shih tzu"
        ],
        "en": [
          "shih tzu",
          "shih tzu dog"
        ]
      },
      "attributes": [
        {
          "attribute_id": "facial_hair",
          "value": "Có râu, ria và lông mọc hướng lên trên mõm, tạo kiểu mặt như cánh hoa cúc. Mặt và mõm đủ rõ, buộc hoặc tỉa lông có thể đổi viền mặt.",
          "source_ids": [
            "fci-208"
          ]
        },
        {
          "attribute_id": "body_build",
          "value": "Thân chắc, chiều dài từ vai tới gốc đuôi lớn hơn chiều cao vai theo chuẩn. Dáng ngang đủ vai và gốc đuôi. Không suy tỷ lệ chính xác từ góc xiên.",
          "source_ids": [
            "fci-208"
          ]
        },
        {
          "attribute_id": "muzzle_length",
          "value": "Mõm ngắn theo chuẩn. Chiều rộng và độ vuông là mô tả khác của hình mõm. Ảnh ngang thấy mũi và điểm stop, tóc có thể che. Không suy 2,5 cm từ ảnh.",
          "source_ids": [
            "fci-208"
          ]
        },
        {
          "attribute_id": "coat_length",
          "value": "Lông ngoài dài, dày, không xoăn theo chuẩn, có thể hơi gợn. Lông khô và rõ thân. Grooming có thể làm lông thực tế ngắn.",
          "source_ids": [
            "fci-208"
          ]
        }
      ]
    }
