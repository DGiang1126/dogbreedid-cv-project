        },
        {
          "attribute_id": "coat_texture",
          "value": "Lông phẳng hoặc gợn. Góc đủ thấy thân, lông khô.",
          "source_ids": [
            "fci-111"
          ]
        },
        {
          "attribute_id": "coat_length",
          "value": "Lông dài trang trí rõ ở dạng feathering theo chuẩn; nguồn không nêu một chiều dài toàn thân cố định. Thấy vùng lông tua, grooming hoặc crop có thể làm giảm tín hiệu.",
          "source_ids": [
            "fci-111"
          ]
        }
      ]
    },
    {
