      "attributes": [
        {
          "attribute_id": "body_build",
          "value": "Dáng gọn hơi thuôn dài, tỷ lệ cao:dài chuẩn 8:10. Ảnh ngang trên mặt phẳng, đủ chân và thân. Tỷ lệ chuẩn không dùng như phép đo từ crop.",
          "source_ids": [
            "fci-047"
          ]
        },
        {
          "attribute_id": "coat_color",
          "value": "Nền đen với mảng vàng nâu đến đỏ nâu và trắng. Mặt và thân nhìn rõ. Màu tam thể chồng lấn.",
          "source_ids": [
            "fci-047"
          ]
        },
        {
          "attribute_id": "coat_length",
          "value": "Lông ngoài ngắn, áp thân. Thân rõ, tránh lông bị nén.",
          "source_ids": [
            "fci-047"
          ]
        }
      ]
    },
    {
      "class_id": 6,
