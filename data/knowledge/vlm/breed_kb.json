      "attributes": [
        {
          "attribute_id": "body_build",
          "value": "Thân lực lưỡng, xương nặng và cơ bắp. Chó đứng ngang, thấy chân và thân, đối chiếu cùng tuổi trưởng thành khi có thể.",
          "source_ids": [
            "fci-058"
          ]
        },
        {
          "attribute_id": "tail_shape",
          "value": "Đuôi nặng, rủ lúc nghỉ, chỉ cong nhẹ lên khi nâng. Thấy đuôi và tư thế, ảnh tĩnh lúc nghỉ ít phân biệt hơn.",
          "source_ids": [
            "fci-058"
          ]
        },
        {
          "attribute_id": "coat_color",
          "value": "Nền đen với mảng nâu đỏ và trắng, kiểu tam thể điển hình. Thân và mặt đủ sáng.",
          "source_ids": [
            "fci-058"
          ]
        }
      ]
    },
    {
