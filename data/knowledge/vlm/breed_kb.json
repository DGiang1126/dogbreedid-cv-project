      "attributes": [
        {
          "attribute_id": "body_build",
          "value": "Dáng gọn gần vuông theo mô tả, tỷ lệ cao:dài chuẩn 9:10. Ảnh ngang, đủ điểm vai và mông.",
          "source_ids": [
            "fci-046"
          ]
        },
        {
          "attribute_id": "tail_shape",
          "value": "Đuôi cuộn chặt trên mông khi chuyển động. Khi nghỉ có thể thả. Ảnh đang di chuyển và thấy đường viền đuôi.",
          "source_ids": [
            "fci-046"
          ]
        },
        {
          "attribute_id": "coat_color",
          "value": "Tam thể với mảng nâu đỏ và trắng, nền có thể đen hoặc nâu Havana. Ánh sáng trung tính.",
          "source_ids": [
            "fci-046"
          ]
        }
      ]
    },
    {
      "class_id": 5,
      "canonical_name": "EntleBucher",
      "aliases": {
        "vi": [
