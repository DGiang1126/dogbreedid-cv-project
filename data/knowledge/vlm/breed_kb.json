        ],
        "en": [
          "golden retriever dog"
        ]
      },
      "attributes": [
        {
          "attribute_id": "coat_color",
          "value": "Lông trong dải vàng hoặc kem trong tiêu chuẩn, có thể có ít sợi trắng ở ngực. Thân đủ sáng.",
          "source_ids": [
            "fci-111"
