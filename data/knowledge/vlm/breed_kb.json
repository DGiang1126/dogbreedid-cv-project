          "border collie dog"
        ]
      },
      "attributes": [
        {
          "attribute_id": "head_shape",
          "value": "Sọ khá rộng và đoạn chuyển trán–mõm rõ. Ảnh nghiêng, đọc đường chuyển trán–mõm; không dùng như điều kiện đủ.",
          "source_ids": [
            "fci-297"
          ]
        },
        {
          "attribute_id": "ear_position",
          "value": "Tai dựng hoặc bán dựng và linh hoạt theo trạng thái. Hai tai hiện rõ.",
          "source_ids": [
            "fci-297"
          ]
        },
        {
          "attribute_id": "tail_shape",
          "value": "Đuôi có điểm gắn thấp, đoạn chót thường cong lên. Thấy toàn đuôi và tư thế mang.",
          "source_ids": [
            "fci-297"
          ]
        }
      ]
    },
    {
